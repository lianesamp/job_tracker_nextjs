# Get your connection strings from https://neon.tech
# Pooled connection (for the app — used in serverless environments)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection (for migrations — drizzle-kit needs direct access)
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Set to "true" on Vercel to disable create/edit/delete for public visitors.
# Locally, leave as "false" so you can use the app normally.
DEMO_MODE="false"
